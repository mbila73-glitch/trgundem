// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Source {
  id          String    @id @default(cuid())
  name        String
  url         String    @unique
  category    String?
  active      Boolean   @default(true)
  lastFetched DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  articles    Article[]

  @@index([active])
}

model Article {
  id            String    @id @default(cuid())
  sourceId      String
  source        Source    @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  guid          String
  title         String
  link          String
  description   String?
  content       String?
  author        String?
  category      String?
  imageUrl      String?
  publishedAt   DateTime
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  summary       String?
  summarizedAt  DateTime?
  summaryError  String?
  isFeatured    Boolean   @default(false)

  @@unique([sourceId, guid])
  @@index([publishedAt])
  @@index([sourceId])
  @@index([category])
  @@index([isFeatured])
}

// AI-generated published article (paraphrased from multiple source articles).
// Each row corresponds to a "story" that appeared in 2+ different RSS sources.
model PublishedArticle {
  id              String   @id @default(cuid())
  aiTitle         String
  aiSummary       String
  imageUrl        String?
  category        String
  wordCount       Int      @default(0)
  sourceArticleIds String  // JSON array of Article.id (the raw sources used)
  sourceCount     Int      // number of distinct sources the story appeared in
  earliestPublishedAt DateTime
  latestPublishedAt   DateTime
  status          String   @default("draft")  // "draft" | "published" | "archived" | "pending_review" | "duplicate"
  publishedAt     DateTime?
  archivedAt      DateTime? // arşive alındığı tarih (status='archived' olduğunda)
  initialHearts   Int      @default(0)  // yayına alınırken random atanır (223-413)
  clickHearts     Int      @default(0)  // okuyucu tıklama sayısı (gerçek)
  isEdited        Boolean  @default(false)  // true = yeşil çerçeve (yayınlandı/düzenlendi), false = kırmızı çerçeve (bekliyor)
  editedAt        DateTime?  // isEdited=true olduğu an — audit için
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([category])
  @@index([status])
  @@index([publishedAt])
  @@index([archivedAt])
  @@index([isEdited])
}

// Beğeni logu — IP başına 1 kez beğenme kontrolü
model HeartLog {
  id         String   @id @default(cuid())
  articleId  String
  ip         String
  createdAt  DateTime @default(now())

  @@unique([articleId, ip])  // aynı IP aynı makaleye 1 kez beğenebilir
  @@index([articleId])
}

// Güvenilen haber siteleri — admin panelinden eklenir/silinir
model TrustedSite {
  id         String   @id @default(cuid())
  name       String   // "Sözcü", "CNN Türk"
  searchUrl  String   // "https://www.sozcu.com.tr/ara/?q={query}" — {query} yerine arama kelimesi
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
}

model ReaderMessage {
  id         String   @id @default(cuid())
  name       String
  email      String
  subject    String
  message    String
  ip         String?  // okuyucunun IP adresi (X-Forwarded-For)
  status     String   @default("new")  // "new" | "read" | "archived" | "deleted"
  reply      String?  // yönetici cevabı
  repliedAt  DateTime? // cevap gönderildiği tarih
  createdAt  DateTime @default(now())

  @@index([status])
  @@index([createdAt])
}
